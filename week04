import random
import time

print("      THE MYSTERY BOX CHALLENGE")

name = input("What is your name? ")

score = 0
round_number = 1

while True:
    print("\nHello,", name)
    print("Round:", round_number)
    print("Your score:", score)

    print("\nChoose a mystery box:")
    print("1. Red Box")
    print("2. Blue Box")
    print("3. Gold Box")
    print("4. Exit Game")

    choice = input("Your choice (1-4): ")

    if choice == "4":
        break

    elif choice == "1" or choice == "2" or choice == "3":
        print("\nOpening your mystery box...")
        time.sleep(1)

        prize = random.choice([
            10, 20, 50, -10, 100
        ])

        if prize == 10:
            print("You found 10 points!")
        elif prize == 20:
            print("You found 20 points!")
        elif prize == 50:
            print("You found 50 points!")
        elif prize == -10:
            print("Oh no! You lost 10 points!")
        else:
            print("Amazing! You found a 100-point bonus!")

        score = score + prize

        if score < 0:
            score = 0

        round_number = round_number + 1

    else:
        print("Invalid choice! Please choose 1, 2, 3 or 4.")
        continue

print("             GAME OVER")
print("Player:", name)
print("Final score:", score)

if score >= 100:
    print("Amazing! You are a Mystery Master!")
elif score >= 50:
    print("Great job! You are a Lucky Player!")
elif score > 0:
    print("Nice try! Keep playing!")
else:
    print("Better luck next time!")

print("Thanks for playing!")
